{
  "name": "nocturnal-wallet",
  "description": "Nocturnal — Canton Network wallet browser extension with CIP-0103 dApp API support",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_BRAND=nocturnal wxt",
    "dev:firefox": "VITE_BRAND=nocturnal wxt -b firefox",
    "build": "VITE_BRAND=nocturnal wxt build",
    "build:prod": "VITE_BRAND=nocturnal wxt build --mode mainnet",
    "build:firefox": "VITE_BRAND=nocturnal wxt build -b firefox",
    "build:all": "VITE_BRAND=nocturnal wxt build && VITE_BRAND=nocturnal wxt build -b firefox",
    "zip": "VITE_BRAND=nocturnal wxt zip",
    "zip:firefox": "VITE_BRAND=nocturnal wxt zip -b firefox",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@canton-network/core-signing-lib": "^1.3.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.87.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bignumber.js": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.542.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.68.0",
    "react-number-format": "^5.4.4",
    "socket.io-client": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.2.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/chrome": "^0.0.304",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "wxt": "^0.20.17"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
