VITE_ENCRYPTION_BACKEND=webcrypto
VITE_SALT_ROUNDS=10
VITE_AUTO_LOCK_MINUTES=15

# The active brand is nocturnal (the only brand); it is selected at build time
# via VITE_BRAND=nocturnal in the package.json scripts. Do not put VITE_BRAND here.
#
# Party hint comes from branding/nocturnal/brand.ts (partyHintDefault).
# API and explorer URLs come from branding/nocturnal/brand.ts + lib/network.ts.
#
# Google OAuth lives in the brand pack (gitignored):
#   cp branding/nocturnal/.env.example branding/nocturnal/.env
# See branding/README.md and branding/nocturnal/oauth-setup.md.
