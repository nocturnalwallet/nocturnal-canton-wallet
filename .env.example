VITE_ENCRYPTION_BACKEND=webcrypto
VITE_SALT_ROUNDS=10
VITE_AUTO_LOCK_MINUTES=15

# Active brand is selected at build time via VITE_BRAND=ginkgo|nocturnal
# (see package.json scripts). Do not put VITE_BRAND in this file.
#
# Party hint comes from branding/<id>/brand.ts (partyHintDefault).
# API and explorer URLs come from branding/<id>/brand.ts + lib/network.ts.
#
# Google OAuth lives in each brand pack (gitignored):
#   cp branding/ginkgo/.env.example branding/ginkgo/.env
#   cp branding/nocturnal/.env.example branding/nocturnal/.env
# See branding/README.md and branding/nocturnal/oauth-setup.md.
