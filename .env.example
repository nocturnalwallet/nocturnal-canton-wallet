VITE_API_BASE_URL=https://api-devnet.kairo.ag/
VITE_ENCRYPTION_BACKEND=webcrypto
VITE_SALT_ROUNDS=10
VITE_EXPLORER_LINK=https://lighthouse.devnet.cantonloop.com
VITE_AUTO_LOCK_MINUTES=15

# Google OAuth — same client ID as the web app.
# IMPORTANT: You must add the extension's redirect URI to the OAuth client's
# "Authorized redirect URIs" in Google Cloud Console.
# The redirect URI is: https://<extension-id>.chromiumapp.org/
# With the current manifest key, the extension ID is: nedmfnmjfdneopknpheohpcngdaeipec
# So the redirect URI to register is: https://nedmfnmjfdneopknpheohpcngdaeipec.chromiumapp.org/
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
