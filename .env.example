VITE_API_BASE_URL=https://api-devnet.kairo.ag/
VITE_ENCRYPTION_BACKEND=webcrypto
VITE_SALT_ROUNDS=10
VITE_EXPLORER_LINK=https://lighthouse.devnet.cantonloop.com
VITE_AUTO_LOCK_MINUTES=15

# Active brand is selected at build time via VITE_BRAND=ginkgo|nocturnal
# (see package.json scripts: yarn build / yarn build:nocturnal). Do not put
# VITE_BRAND in this file — scripts set it explicitly.
#
# Party hint for onboarding comes from branding/<id>/brand.ts
# (partyHintDefault). Do not set VITE_PARTY_HINT — a shared .env value would
# bake the wrong hint into every brand build.

# Google OAuth — same client ID as the web app (or a per-brand client).
# IMPORTANT: You must add each brand's redirect URI to the OAuth client's
# "Authorized redirect URIs" in Google Cloud Console.
# Ginkgo (default): extension ID nedmfnmjfdneopknpheohpcngdaeipec
#   → https://nedmfnmjfdneopknpheohpcngdaeipec.chromiumapp.org/
# Nocturnal: see branding/nocturnal/oauth-setup.md
#   → https://iijglelilemfjgadbekgleiclimbaopf.chromiumapp.org/
#
# If Nocturnal uses a separate Google Cloud project/client, swap
# VITE_GOOGLE_CLIENT_ID / SECRET before yarn build:nocturnal (or keep both
# redirect URIs on one shared client).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
